PORT=8787
ALLOW_PUBLIC_ACCESS=false
APP_ACCESS_PASSWORD=

# xAI/Grok is tried first when configured. API usage may be billable.
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning
XAI_API_URL=https://api.x.ai/v1

# Groq is the first fallback. Free usage limits may apply.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_URL=https://api.groq.com/openai/v1

# Optional fallback provider. The app only calls it if configured Groq fails.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# Optional Roblox live operations; keep the key only in the server environment.
ROBLOX_OPEN_CLOUD_API_KEY=

# Optional GitHub artifact saving.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_BRANCH=main
